{
  "name": "keyframe",
  "version": "1.0.0",
  "private": true,
  "description": "bunny.net marketing videos: React and HTML frames, Web Audio sound, Chromium capture, AVFoundation encode",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @keyframe/videos",
    "render": "npm run render -w @keyframe/videos --",
    "lint": "tsc -p . && biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3"
  }
}
