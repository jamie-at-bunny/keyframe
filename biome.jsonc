{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "files": {
    "includes": ["**", "!out", "!.cache", "!public", "!kit/fonts"]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "semicolons": "always", "trailingCommas": "all" }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      // Code lines, tokens and terminal segments are fixed lists drawn per frame and never
      // reorder, so the index is their identity.
      "suspicious": { "noArrayIndexKey": "off" }
    }
  },
  "overrides": [
    {
      // Videos are rendered to pixels; nothing in a frame is read by assistive tech.
      // The studio (engine/studio.tsx) keeps the accessibility rules.
      "includes": ["kit/**", "campaigns/**"],
      "linter": { "rules": { "a11y": "off" } }
    }
  ],
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
